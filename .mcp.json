{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "shrimp-task-manager": {
      "command": "node",
      "args": [
        "C:\\workspace\\mcp-shrimp-task-manager-main\\dist\\index.js"
      ],
      "env": {
        "DATA_DIR": "C:\\workspace\\todo\\shrimp-data",
        "TEMPLATES_USE": "en",
        "ENABLE_GUI": "true"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
